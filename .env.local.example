# ─── Supabase ───────────────────────────────────────────────
# Project URL and keys from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role key is SECRET — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Resend (email notifications) ───────────────────────────
# API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where inquiry emails are delivered:
CONTACT_TO_EMAIL=you@example.com
# Verified sender (must be a domain you've verified in Resend). The default
# onboarding@resend.dev works for testing without a verified domain.
RESEND_FROM_EMAIL=Amr Studio <onboarding@resend.dev>

# ─── Admin dashboard (/admin) ───────────────────────────────
# Admin users now live in the database, not here. Run supabase/schema.sql,
# which creates the admin_users table and inserts your admin login. Add more
# admins with:
#   insert into public.admin_users (email, password)
#   values ('you@example.com', crypt('your-password', gen_salt('bf')));
