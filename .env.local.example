# ─── Supabase ───────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → Data API (URL) and → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret key (sb_secret_…) is SECRET — server-only, bypasses RLS. Never expose
# it to the client or prefix it with NEXT_PUBLIC_. Do NOT use the publishable
# (sb_publishable_…) key here.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Older projects only: the legacy JWT service_role key still works as a
# fallback when SUPABASE_SECRET_KEY is not set.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ─── Resend (email notifications) ───────────────────────────
# API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Where inquiry emails are delivered:
CONTACT_TO_EMAIL=you@example.com
# Verified sender (must be a domain you've verified in Resend). The default
# onboarding@resend.dev works for testing without a verified domain.
RESEND_FROM_EMAIL=Amr Studio <onboarding@resend.dev>
# Sender for proposals / invoices (optional):
# RESEND_PROPOSALS_FROM_EMAIL=Amr Studio <proposals@amrstudio.dev>

# ─── Admin dashboard (/admin) ───────────────────────────────
# Admin users live in the database, not here. On a new project run, in order:
#   1. supabase/setup.sql        tables, functions, privileges
#   2. supabase/admin-users.sql  your admin logins (set new passwords first)
